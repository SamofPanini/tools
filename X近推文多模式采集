// ==UserScript==
// @name         X近推文多模式采集
// @namespace    local.x.latest3
// @version      1.2.1
// @description  手动启动；1/3/5条独立名单；暗色紧凑界面；按账号只显示新增推文；可调5标签页并发；复制Markdown。
// @match        https://x.com/*
// @match        https://twitter.com/*
// @run-at       document-start
// @noframes
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_deleteValue
// @grant        GM_addValueChangeListener
// @grant        GM_removeValueChangeListener
// @grant        GM_openInTab
// @grant        GM_setClipboard
// ==/UserScript==

(() => {
  'use strict';

  // 显示宽度直接改这里（px）；小屏会自动缩窄。
  const PANEL_WIDTH_PX = 580;
  const MAX_CONCURRENT_TABS = 5;
  const MAX_POSTS_PER_ACCOUNT = 20;
  const WORKER_WAIT_MS = 35000;
  const TAB_TIMEOUT_MS = 45000;
  const RUN_PARAM = 'tm_latest3';
  const COUNT_PARAM = 'tm_latest3_count';
  const DEFAULT_ACCOUNTS = 'OpenAI\nAnthropicAI\nGoogleDeepMind';
  const MODES = {
    single: {label: '最新 1 条', defaultCount: 1},
    triple: {label: '最新 3 条', defaultCount: 3},
    quintuple: {label: '最新 5 条', defaultCount: 5}
  };

  const pageUrl = new URL(location.href);
  const launchRun = pageUrl.searchParams.get(RUN_PARAM);
  const profile = location.pathname.match(/^\/([A-Za-z0-9_]{1,15})\/?$/);
  const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));
  const clampInt = (value, min, max, fallback) => {
    if (value === '' || value === null || value === undefined) return fallback;
    const n = Number(value);
    return Number.isFinite(n) ? Math.max(min, Math.min(max, Math.round(n))) : fallback;
  };
  const resultKey = (run, username) => `latest3:${run}:${username.toLowerCase()}`;
  // 每档、每个账号只存一份最新基准；不会积累历史记录。
  const baselineKey = (mode, username) => `latest3:seen:v1:${mode}:${username.toLowerCase()}`;

  // X status ID 大体按时间单调递增；同秒推文靠 ID 精确区分。
  function postId(post) {
    const match = (post?.url || '').match(/\/status\/(\d+)/);
    return match ? match[1] : (String(post?.id || '').match(/^\d+$/) ? String(post.id) : '');
  }
  function compareId(a, b) {
    if (!a || !b || !/^\d+$/.test(a) || !/^\d+$/.test(b)) return null;
    try { const x = BigInt(a), y = BigInt(b); return x === y ? 0 : x > y ? 1 : -1; }
    catch (_) { return null; }
  }
  function newerThan(post, reference) {
    if (!reference) return true;
    const byId = compareId(postId(post), reference.id);
    if (byId !== null) return byId > 0;
    const a = Date.parse(post.date || ''), b = Date.parse(reference.date || '');
    return Number.isFinite(a) && Number.isFinite(b) && a > b;
  }
  function newestFirst(a, b) {
    const x = compareId(postId(a), postId(b));
    if (x !== null) return -x;
    return (Date.parse(b.date || '') || 0) - (Date.parse(a.date || '') || 0);
  }
  function validBaseline(value) {
    return value && typeof value === 'object' &&
      (/^\d+$/.test(String(value.id || '')) || Number.isFinite(Date.parse(value.date || '')))
      ? value : null;
  }
  function readBaseline(mode, username) {
    return validBaseline(GM_getValue(baselineKey(mode, username), null));
  }
  function summarizeNew(mode, username, raw) {
    const previous = readBaseline(mode, username);
    const record = {
      ...raw, previous, latest: previous,
      posts: [], firstRun: false, newCount: 0
    };
    if (raw?.error || !Array.isArray(raw?.posts) || raw.posts.length === 0) return record;
    const posts = [...raw.posts].sort(newestFirst);
    const newest = posts[0];
    // 未识别出可比对的最新 ID/时间：避免意外清空或污染已有基准。
    if (!postId(newest) && !Number.isFinite(Date.parse(newest.date || ''))) {
      record.error = '无法识别最新推文的时间或 ID，本次不更新基准。';
      return record;
    }
    record.firstRun = !previous;
    record.posts = previous ? posts.filter(post => newerThan(post, previous)) : posts;
    record.newCount = record.posts.length;
    if (!previous || newerThan(newest, previous)) {
      const latest = {id: postId(newest), date: newest.date || '', checkedAt: new Date().toISOString()};
      GM_setValue(baselineKey(mode, username), latest);
      record.latest = latest;
    }
    return record;
  }

  function readPosts(username, found) {
    const wanted = username.toLowerCase();
    for (const article of document.querySelectorAll('article[data-testid="tweet"]')) {
      if (article.parentElement?.closest('article[data-testid="tweet"]')) continue;
      if (article.querySelector('[data-testid="placementTracking"]')) continue;
      const timeEl = article.querySelector('time[datetime]');
      const path = timeEl?.closest('a[href]')?.getAttribute('href') || '';
      const match = path.match(/^\/([A-Za-z0-9_]+)\/status\/(\d+)/);
      if (!match || match[1].toLowerCase() !== wanted) continue;
      const context = article.querySelector('[data-testid="socialContext"]')?.innerText || '';
      const intro = (article.innerText || '').slice(0, 155).trim();
      if (/Pinned|置顶|置頂|固定|ピン留め/i.test(context) ||
          /^(Pinned|置顶|置頂|固定|ピン留め)/i.test(intro)) continue;
      if (/(?:Replying to\s+@|回复\s*@|回覆\s*@|返信先\s*[:：]?\s*@)/i.test(intro)) continue;
      const tweetText = Array.from(article.querySelectorAll('[data-testid="tweetText"]'))
        .find(el => !el.closest('[data-testid="quoteTweet"]'));
      found.set(match[2], {
        id: match[2], username: match[1],
        text: tweetText?.innerText?.trim() || '（无正文文本，可能是图片／视频）',
        date: timeEl.getAttribute('datetime'),
        url: `https://x.com/${match[1]}/status/${match[2]}`
      });
    }
  }

  async function runWorker(username, run, count) {
    const found = new Map();
    const start = Date.now();
    while (!document.body && Date.now() - start < WORKER_WAIT_MS) await sleep(250);
    await sleep(1100);
    while (Date.now() - start < WORKER_WAIT_MS) {
      readPosts(username, found);
      if (found.size >= count) break;
      window.scrollBy(0, Math.max(650, Math.floor(innerHeight * 0.75)));
      await sleep(1250);
    }
    const posts = [...found.values()].sort(newestFirst).slice(0, count);
    GM_setValue(resultKey(run, username), {
      posts,
      error: posts.length ? '' : '未读到推文：账号可能不可见、需登录，或 X 页面结构已变化。',
      incomplete: posts.length > 0 && posts.length < count,
      collectedAt: new Date().toISOString()
    });
  }

  // 后台账号标签页只运行抓取；普通 X 页面不会自行抓取。
  if (launchRun && profile) {
    const count = clampInt(pageUrl.searchParams.get(COUNT_PARAM), 1, MAX_POSTS_PER_ACCOUNT, 3);
    runWorker(profile[1], launchRun, count).catch(err => {
      GM_setValue(resultKey(launchRun, profile[1]), {posts: [], error: String(err)});
    });
    return;
  }

  function toMarkdown(username, record) {
    const lines = [`## @${username}`];
    if (!record) return lines.join('\n');
    if (record.error) lines.push(`抓取失败：${record.error}`);
    if (!record.error) {
      lines.push(`新增：${record.newCount || 0} 条`);
      if (record.firstRun) lines.push('首次采集：已建立最新推文基准。');
      if (record.incomplete) lines.push('提示：读取数量少于目标值，可能受加载、权限或过滤影响。');
      if (record.previous?.date) lines.push(`上次最新：${record.previous.date}`);
      if (!record.posts?.length) {
        lines.push(`无更新${record.latest?.date ? `（最新记录：${record.latest.date}）` : ''}`);
      }
    }
    for (const [index, p] of (record.posts || []).entries()) {
      lines.push(`\n${index + 1}. ${p.date || '时间未知'}\n\n${p.text}\n\n${p.url}`);
    }
    if (record.error && record.previous?.date) lines.push(`保存的上次最新：${record.previous.date}`);
    return lines.join('\n');
  }

  function parseAccounts(input) {
    const names = input.split(/[\n,，\s]+/)
      .map(s => s.replace(/^@/, '').trim())
      .filter(s => /^[A-Za-z0-9_]{1,15}$/.test(s));
    return [...new Map(names.map(s => [s.toLowerCase(), s])).values()].slice(0, 20);
  }

  function initPanel() {
    if (!document.body || document.getElementById('tm-latest3-root')) return;
    const host = document.createElement('div');
    host.id = 'tm-latest3-root';
    host.style.cssText = `position:fixed;right:16px;top:18px;z-index:2147483647;font:13px/1.5 system-ui,-apple-system,sans-serif;color:#e7e9ea;--panel-width:${PANEL_WIDTH_PX}px;`;
    const shadow = host.attachShadow({mode: 'open'});
    shadow.innerHTML = `
      <style>
        *{box-sizing:border-box}
        button,textarea,input{font:inherit}
        button{cursor:pointer;border:1px solid #3b4248;border-radius:8px;background:#20272e;color:#e7e9ea;padding:7px 11px}
        button:hover:not(:disabled){background:#293440}
        button:disabled{opacity:.5;cursor:default}
        .toggle{background:#172c3c;color:#fff;border:1px solid #365c77;box-shadow:0 4px 16px #0008;font-weight:700}
        .panel{display:none;width:min(var(--panel-width),calc(100vw - 24px));max-height:82dvh;overflow-y:auto;margin-top:9px;background:#10171d;border:1px solid #35414a;border-radius:12px;box-shadow:0 8px 30px #0009;padding:14px;color:#e7e9ea;color-scheme:dark}
        .panel.open{display:block}
        .heading{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:15px;font-weight:750;margin-bottom:9px}
        .minimize{padding:0;min-width:29px;height:26px;border-radius:7px;line-height:1;font-size:19px;font-weight:500}
        .mode-tabs,.account-tabs,.actions,.settings{display:flex;gap:7px;align-items:center}
        .mode-tabs{margin:0 0 10px}
        .mode-tabs button{flex:1;min-width:0;padding:7px 5px}
        button.selected{color:#fff;background:#164b72;border-color:#4099d3}
        .mode-pane{display:none}
        .mode-pane.selected{display:block}
        label{display:block;font-weight:650;margin:6px 0 4px}
        textarea,input{border:1px solid #3a4650;border-radius:8px;padding:7px 9px;background:#17212a;color:#e7e9ea;outline:none}
        textarea:focus,input:focus{border-color:#62ace0}
        textarea{width:100%;resize:vertical;min-height:74px}
        input[type=number]{width:65px;min-width:0}
        .settings{margin-top:9px;flex-wrap:nowrap;gap:16px}
        .settings label{margin:0;font-weight:500;white-space:nowrap}
        .setting{display:flex;gap:6px;align-items:center;min-width:0}
        .hint{color:#9aaab8;font-size:12px;line-height:1.5;margin:8px 0}
        .actions{margin:10px 0;flex-wrap:wrap}
        .primary{background:#1b719f;color:#fff;border-color:#369acd;font-weight:700}
        .primary:hover:not(:disabled){background:#2285b9}
        .status{font-size:12px;color:#b0c1cd;margin:7px 0 5px;line-height:1.5}
        .account-tabs{margin:0 0 7px;max-height:115px;overflow:auto;flex-wrap:wrap}
        .account-tabs button{font-size:12px;padding:4px 8px}
        .output{min-height:140px;height:190px;white-space:pre-wrap}
        .empty{color:#8e9ca7;font-size:12px;margin:8px 0}
        @media(max-width:440px){.panel{padding:11px}.settings{gap:8px}.setting{gap:4px}.setting label{font-size:12px}.setting input{width:49px}.mode-tabs button{font-size:12px}.actions button{padding:6px 8px}}
      </style>
      <button class="toggle" id="toggle" type="button" aria-expanded="false" aria-controls="panel">X 推文采集</button>
      <div class="panel" id="panel">
        <div class="heading"><span>X 指定账号 · 最近推文</span><button id="minimize" class="minimize" type="button" aria-label="缩小面板" title="缩小面板">−</button></div>
        <div class="mode-tabs">
          <button id="tab-single" class="selected" type="button">最新 1 条</button>
          <button id="tab-triple" type="button">最新 3 条</button>
          <button id="tab-quintuple" type="button">最新 5 条</button>
        </div>
        <section class="mode-pane selected" id="pane-single">
          <label for="accounts-single">账号列表（每行一个，无需 @）</label>
          <textarea id="accounts-single" rows="4" spellcheck="false"></textarea>
        </section>
        <section class="mode-pane" id="pane-triple">
          <label for="accounts-triple">账号列表（每行一个，无需 @）</label>
          <textarea id="accounts-triple" rows="4" spellcheck="false"></textarea>
        </section>
        <section class="mode-pane" id="pane-quintuple">
          <label for="accounts-quintuple">账号列表（每行一个，无需 @）</label>
          <textarea id="accounts-quintuple" rows="4" spellcheck="false"></textarea>
        </section>
        <div class="settings">
          <div class="setting"><label for="count">每账号</label><input id="count" type="number" min="1" max="20" step="1"><span>条</span></div>
          <div class="setting"><label for="concurrency">后台并发</label><input id="concurrency" type="number" min="1" max="5" step="1"><span>页</span></div>
        </div>
        <div class="hint">默认过滤置顶、转推及可识别的回复。</div>
        <div class="actions">
          <button id="start" class="primary" type="button">▶ 启动抓取</button>
          <button id="copy-current" type="button" disabled>复制当前账号</button>
          <button id="copy-all" type="button" disabled>复制本组新增</button>
        </div>
        <div class="status" id="status" role="status">尚未开始抓取。</div>
        <div class="account-tabs" id="account-tabs"></div>
        <div class="empty" id="empty">抓取后点击账号名查看新增推文。</div>
        <textarea id="output" class="output" rows="9" readonly placeholder="这里仅显示所选账号的新增推文"></textarea>
      </div>`;
    document.body.appendChild(host);

    const $ = id => shadow.getElementById(id);
    let activeMode = 'single';
    let isRunning = false;
    const sessions = Object.fromEntries(Object.keys(MODES).map(id => [id, {
      usernames: [], data: new Map(), selected: null, done: 0,
      status: '尚未开始抓取。', lastCount: MODES[id].defaultCount
    }]));
    const modeCounts = {};
    const inheritedAccounts = GM_getValue('latest3:accounts', DEFAULT_ACCOUNTS);
    for (const [id, mode] of Object.entries(MODES)) {
      $(`accounts-${id}`).value = GM_getValue(`latest3:accounts:${id}`, inheritedAccounts);
      modeCounts[id] = clampInt(GM_getValue(`latest3:count:${id}`, mode.defaultCount), 1, MAX_POSTS_PER_ACCOUNT, mode.defaultCount);
      $(`accounts-${id}`).addEventListener('change', () => GM_setValue(`latest3:accounts:${id}`, $(`accounts-${id}`).value));
      $(`tab-${id}`).onclick = () => setMode(id);
    }
    $('count').value = modeCounts[activeMode];
    $('count').addEventListener('change', () => {
      const value = clampInt($('count').value, 1, MAX_POSTS_PER_ACCOUNT, MODES[activeMode].defaultCount);
      $('count').value = value;
      modeCounts[activeMode] = value;
      GM_setValue(`latest3:count:${activeMode}`, value);
    });
    $('concurrency').value = clampInt(GM_getValue('latest3:concurrency', 2), 1, MAX_CONCURRENT_TABS, 2);
    $('concurrency').addEventListener('change', () => {
      const value = clampInt($('concurrency').value, 1, MAX_CONCURRENT_TABS, 2);
      $('concurrency').value = value;
      GM_setValue('latest3:concurrency', value);
    });
    function setPanelOpen(open) {
      $('panel').classList.toggle('open', open);
      $('toggle').setAttribute('aria-expanded', String(open));
    }
    $('toggle').onclick = () => setPanelOpen(!$('panel').classList.contains('open'));
    $('minimize').onclick = () => setPanelOpen(false);

    function buildAllMarkdown(session) {
      return `# X 最近推文 · 增量采集\n\n${session.usernames.filter(u => session.data.has(u))
        .map(u => toMarkdown(u, session.data.get(u))).join('\n\n---\n\n')}`;
    }
    function render() {
      const session = sessions[activeMode];
      $('status').textContent = session.status;
      const tabs = $('account-tabs');
      tabs.replaceChildren();
      for (const username of session.usernames) {
        if (!session.data.has(username)) continue;
        const record = session.data.get(username);
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = `@${username} · ${record.error ? '失败' : `${record.newCount || 0}`}`;
        if (username === session.selected) button.classList.add('selected');
        button.onclick = () => { session.selected = username; render(); };
        tabs.appendChild(button);
      }
      const current = session.selected && session.data.get(session.selected);
      $('output').value = current ? toMarkdown(session.selected, current) : '';
      $('empty').style.display = current ? 'none' : 'block';
      $('empty').textContent = session.usernames.length ? '抓取中，等待账号结果…' : '抓取后点击账号名查看新增推文。';
      $('copy-current').disabled = !current;
      $('copy-all').disabled = session.data.size === 0;
      $('start').disabled = isRunning;
    }
    function setMode(modeId) {
      // 切换页签时保存上一组尚未失焦的数字和文本。
      modeCounts[activeMode] = clampInt($('count').value, 1, MAX_POSTS_PER_ACCOUNT, MODES[activeMode].defaultCount);
      GM_setValue(`latest3:count:${activeMode}`, modeCounts[activeMode]);
      GM_setValue(`latest3:accounts:${activeMode}`, $(`accounts-${activeMode}`).value);
      activeMode = modeId;
      $('count').value = modeCounts[modeId];
      for (const id of Object.keys(MODES)) {
        $(`tab-${id}`).classList.toggle('selected', id === modeId);
        $(`pane-${id}`).classList.toggle('selected', id === modeId);
      }
      render();
    }

    function fetchAccount(username, run, count) {
      return new Promise(resolve => {
        let finished = false, tab, timeoutId, listenerId;
        const key = resultKey(run, username);
        function finish(data) {
          if (finished) return;
          finished = true;
          clearTimeout(timeoutId);
          if (listenerId !== undefined) GM_removeValueChangeListener(listenerId);
          try { tab?.close(); } catch (_) { /* 关闭失败不影响数据 */ }
          // 每次运行临时回传的数据即用即删，不累积在 Tampermonkey 的存储中。
          try { GM_deleteValue(key); } catch (_) { /* 不影响抓取 */ }
          resolve(data);
        }
        listenerId = GM_addValueChangeListener(key, (_key, _old, value) => {
          if (value && typeof value === 'object') finish(value);
        });
        timeoutId = setTimeout(() => finish({posts: [], error: `超过 ${Math.round(TAB_TIMEOUT_MS / 1000)} 秒：标签页可能被限速或未加载。`}), TAB_TIMEOUT_MS);
        try {
          const url = new URL(`https://x.com/${username}`);
          url.searchParams.set(RUN_PARAM, run);
          url.searchParams.set(COUNT_PARAM, String(count));
          tab = GM_openInTab(url.toString(), {active: false, insert: true, setParent: true});
        } catch (err) { finish({posts: [], error: `打开账号页失败：${err}`}); }
      });
    }

    $('start').onclick = async () => {
      if (isRunning) return;
      const modeId = activeMode;
      const mode = MODES[modeId];
      const accountBox = $(`accounts-${modeId}`);
      const usernames = parseAccounts(accountBox.value);
      if (!usernames.length) {
        sessions[modeId].status = '请输入有效的账号名（例如 OpenAI），每行一个，最多 20 个。';
        render(); return;
      }
      const count = clampInt($('count').value, 1, MAX_POSTS_PER_ACCOUNT, mode.defaultCount);
      const concurrency = clampInt($('concurrency').value, 1, MAX_CONCURRENT_TABS, 2);
      $('count').value = count;
      $('concurrency').value = concurrency;
      modeCounts[modeId] = count;
      GM_setValue(`latest3:accounts:${modeId}`, accountBox.value);
      GM_setValue(`latest3:count:${modeId}`, count);
      GM_setValue('latest3:concurrency', concurrency);

      const session = sessions[modeId];
      session.usernames = usernames;
      session.data = new Map();
      session.selected = null;
      session.done = 0;
      session.lastCount = count;
      session.status = `已完成 0/${usernames.length} · 新增 0 · ${mode.label}`;
      isRunning = true;
      render();
      const run = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;
      let cursor = 0;
      async function work() {
        while (cursor < usernames.length) {
          const username = usernames[cursor++];
          let raw;
          try { raw = await fetchAccount(username, run, count); }
          catch (err) { raw = {posts: [], error: String(err)}; }
          let record;
          try { record = summarizeNew(modeId, username, raw); }
          catch (err) { record = {posts: [], error: `保存基准失败：${err}`, newCount: 0, previous: readBaseline(modeId, username)}; }
          session.data.set(username, record);
          session.done += 1;
          if (!session.selected) session.selected = username;
          const totalNew = [...session.data.values()].reduce((n, d) => n + (d.newCount || 0), 0);
          const errors = [...session.data.values()].filter(d => d.error).length;
          session.status = `已完成 ${session.done}/${usernames.length} · 新增 ${totalNew} 条${errors ? ` · 失败 ${errors}` : ''} · ${mode.label}`;
          if (activeMode === modeId) render();
        }
      }
      try {
        await Promise.all(Array.from({length: Math.min(concurrency, usernames.length)}, () => work()));
      } finally {
        isRunning = false;
        render();
      }
    };

    $('copy-current').onclick = () => {
      const session = sessions[activeMode];
      if (!session.selected || !session.data.has(session.selected)) return;
      GM_setClipboard(toMarkdown(session.selected, session.data.get(session.selected)), 'text');
      session.status += ' · 已复制当前';
      render();
    };
    $('copy-all').onclick = () => {
      const session = sessions[activeMode];
      if (!session.data.size) return;
      GM_setClipboard(buildAllMarkdown(session), 'text');
      session.status += ' · 已复制本组';
      render();
    };
    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPanel, {once: true});
  } else {
    initPanel();
  }
})();
