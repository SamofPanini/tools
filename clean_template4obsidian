// =====================================================
if (link.includes("https://shirasu.io/c/genron")) {

    const lines = body.replace(/\r\n/g, "\n").split("\n");
    let inFence = false;
    let fenceMarker = "";
    body = lines.map(line => {
        // fenced code block 开始 / 结束
        const fenceMatch = line.match(/^\s*(```+|~~~+)/);
        if (fenceMatch) {
            const marker = fenceMatch[1][0];
            if (!inFence) {
                inFence = true;
                fenceMarker = marker;
            } else if (marker === fenceMarker) {
                inFence = false;
                fenceMarker = "";
            }
            return line;
        }
        // fenced code block 内不处理
        if (inFence) {
            return line;
        }
        // 保留 Markdown 标题行开头的 #
        const headingMatch = line.match(/^(\s{0,3})(#{1,6})([ \t]+.*)$/);
        let headingPrefix = "";
        let rest = line;
        if (headingMatch) {
            headingPrefix = headingMatch[1] + headingMatch[2];
            rest = headingMatch[3];
        }
        const protectedParts = [];
        const protect = value => {
            const token = `\uE000${protectedParts.length}\uE001`;
            protectedParts.push(value);
            return token;
        };
        // 1. 先保护整个 HTML 标签
        // 必须放在 URL 保护之前
        rest = rest.replace(
            /<[^>]+>/g,
            match => protect(match)
        );
        // 2. 保护行内代码
        rest = rest.replace(
            /(`+)([\s\S]*?)\1/g,
            match => protect(match)
        );
        // 3. 保护 Markdown 图片与链接中的目标地址
        rest = rest.replace(
            /(!?\[[^\]]*\]\()([^)]+)(\))/g,
            (match, open, url, close) =>
                open + protect(url) + close
        );
        // 4. 保护尖括号形式的 URL
        rest = rest.replace(
            /<https?:\/\/[^>]+>/g,
            match => protect(match)
        );
        // 5. 保护裸 URL
        rest = rest.replace(
            /https?:\/\/[^\s<>()]+/g,
            match => protect(match)
        );
        // 其余 # 转为全角
        rest = rest.replace(/#/g, "＃");
        // 还原受保护内容
        rest = rest.replace(
            /\uE000(\d+)\uE001/g,
            (_, index) => protectedParts[Number(index)]
        );
        return headingPrefix + rest;
    }).join("\n");
}


 // ======================================
