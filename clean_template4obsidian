// 分离 Frontmatter
// =====================================================

let frontmatter = "";
let body = content;

const fmMatch = content.match(
    /^---\n[\s\S]*?\n---\n?/u
);

if (fmMatch) {
    frontmatter = fmMatch[0];
    body = content.slice(frontmatter.length);
}

// =====================================================
// Perplexity
// =====================================================

if (link.includes("https://www.perplexity.ai/")) {

    body = body.normalize("NFKC");

    // 删除「◯件のソース」
    body = body.replace(
        /^[^\n\r]*件\s*の\s*ソース[^\n\r]*[\r\n]*/gmu,
        ""
    );

    // 删除「公開済み」或「公開された」区块
    // 改进逻辑：
    // 1. 先查找“公開済み”或“公開された”附近是否有日期，如果有则暂存。
    // 2. 删除从“公開済み/公開された”开始到下一个“## ”标题之前的所有内容。
    
    let dateToKeep = "";
    
    // 尝试提取日期 (假设日期在关键词后的100个字符内)
    const preCheck = body.match(/(公開済み|公開された)[\s\S]{0,200}?(\d{4}年\d{1,2}月\d{1,2}日)/u);
    if (preCheck) {
        dateToKeep = preCheck[2];
    }

    // 执行删除：从关键词开始，非贪婪匹配直到遇到下一个 ## 标题
    // 注意：这里使用 [\s\S]*? 确保跨行匹配，直到找到 ^## 
    body = body.replace(
        /(公開済み|公開された)[\s\S]*?(?=^##\s)/mu,
        ""
    );

    // 如果之前提取到了日期，将其插入到当前正文的开头（或适当位置）
    // 注意：由于我们删除了大块内容，可能需要根据具体需求调整日期插入位置
    // 这里假设希望日期保留在原来大致的位置，但由于大块删除，通常放在剩余内容的顶部或原位置
    // 更简单的做法：如果删除成功且有日期，手动拼接到剩余内容前，或者在replace回调中处理
    
    // 【更优方案】：直接在 replace 回调中处理，避免二次拼接错误
    body = body.replace(
        /(公開済み|公開された)([\s\S]*?)(?=^##\s)/mu,
        (match, keyword, contentBetween) => {
            // 在删除的内容块中查找日期
            const dateMatch = contentBetween.match(/\d{4}年\d{1,2}月\d{1,2}日/u);
            if (dateMatch) {
                // 保留日期，并添加换行，然后返回空字符串表示删除了其他部分
                // 注意： lookahead (?=^##) 不会消耗 ## 标题，所以 ## 标题会保留
                return `${dateMatch[0]}\n\n`;
            }
            // 如果没有日期，直接删除整个块（返回空字符串）
            return "";
        }
    );

    // 删除「もっと見る」或「もっと知る」及以下全部
    body = body.replace(
        /(もっと見る|もっと知る)[\s\S]*/m,
        ""
    );
}

