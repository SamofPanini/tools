    /\[!\[\[([^\]\r\n]+)\]\]\]\(https?:\/\/[^)\r\n]+\)|!\[\[([^\]\r\n]+)\]\]|!\[[^\]\r\n]*\]\((<[^>\r\n]+>|[^)\r\n]+)\)/g,
    (match, wrappedWiki, wiki, md) => {
            const wikiPath = wrappedWiki || wiki;
            let path = wikiPath
            ? wikiPath.split("|")[0].split("#")[0].trim()
            : md.trim().replace(/^<|>$/g, "").split(/[?#]/)[0];
            if (/^(?:[a-z][a-z0-9+.-]*:|\/\/)/i.test(path))
                return match;
            if (!imageExt.test(path))
                return match;
            try {
                path = decodeURIComponent(path);
            } catch (e) {
                return match;
            }
            const resolved =
                app.metadataCache.getFirstLinkpathDest(path, file.path) ||
                app.vault.getAbstractFileByPath(path.replace(/^\//, ""));
            if (resolved) return match;
            removedImages++;
            removed = true;
            return "";
        }
    );
    // 图片失效：检查原始位置的下2行
    if (removed) {
        for (let offset = 1; offset <= 2; offset++) {
            const nextIndex = index + offset;
            if (
                nextIndex < lines.length &&
                captionPattern.test(lines[nextIndex])
            ) {
                captionLinesToRemove.add(nextIndex);
            }
        }
    }
	 // 图片删除后整行为空：删除该行
	 // 如果紧接的下一行也是空行，则一起删除
	if (removed && cleaned.trim() === "") {
	    if (
	        index + 1 < lines.length &&
	        lines[index + 1].trim() === ""
	    ) {
	        captionLinesToRemove.add(index + 1);
	    }
	    return null;
	}
    return cleaned;

}).filter((line, index) =>
    line !== null && !captionLinesToRemove.has(index)
).join("\n");


// ======================================
// 写回文件
// ======================================
if (frontmatter + body !== content) {
    await app.vault.modify(file, frontmatter + body);
}
// 调试时可查看清理数量
if (removedImages > 0) {
    console.log(
        "Removed missing images:",
        removedImages,
        file.path
    );
}
